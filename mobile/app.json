{
  "expo": {
    "name": "Место",
    "slug": "mesto",
    "scheme": "mesto",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F2FF"
    },
    "ios": {
      "bundleIdentifier": "ru.mesto.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:mesto-go.ru", "applinks:www.mesto-go.ru", "webcredentials:mesto-go.ru"],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Чтобы показать встречи рядом с тобой на карте.",
        "NSPhotoLibraryUsageDescription": "Чтобы выбрать фото для профиля и встречи.",
        "NSCameraUsageDescription": "Чтобы сделать фото для профиля."
      }
    },
    "android": {
      "package": "ru.mesto.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F2FF"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "mesto-go.ru", "pathPrefix": "/e/" },
            { "scheme": "https", "host": "mesto-go.ru", "pathPrefix": "/r/" },
            { "scheme": "https", "host": "mesto-go.ru", "pathPrefix": "/events/" },
            { "scheme": "https", "host": "mesto-go.ru", "pathPrefix": "/people" },
            { "scheme": "https", "host": "mesto-go.ru", "pathPrefix": "/chats" },
            { "scheme": "https", "host": "mesto-go.ru", "pathPrefix": "/city/" },
            { "scheme": "https", "host": "mesto-go.ru", "path": "/my-events" },
            { "scheme": "https", "host": "mesto-go.ru", "path": "/notifications" },
            { "scheme": "https", "host": "www.mesto-go.ru" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "GOOGLE_MAPS_ANDROID_API_KEY"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Чтобы показать встречи рядом с тобой на карте."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Чтобы выбрать фото для профиля и встречи."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6C3BFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://2-xfcn.vercel.app",
      "eas": {
        "projectId": ""
      },
      "appleLogin": true
    }
  }
}
