{
  "expo": {
    "name": "Место",
    "slug": "mesto",
    "scheme": "mesto",
    "version": "0.4.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F2F8"
    },
    "ios": {
      "bundleIdentifier": "ru.mesto.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:mesto-go.ru",
        "applinks:www.mesto-go.ru",
        "webcredentials:mesto-go.ru"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Чтобы показать встречи рядом с тобой на карте.",
        "NSPhotoLibraryUsageDescription": "Чтобы выбрать фото для профиля и встречи.",
        "NSCameraUsageDescription": "Чтобы сделать фото для профиля.",
        "CFBundleDevelopmentRegion": "ru",
        "CFBundleLocalizations": [
          "ru"
        ]
      },
      "buildNumber": "10",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 10,
      "package": "ru.mesto.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F1EEF8"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mesto-go.ru",
              "pathPrefix": "/e/"
            },
            {
              "scheme": "https",
              "host": "mesto-go.ru",
              "pathPrefix": "/r/"
            },
            {
              "scheme": "https",
              "host": "mesto-go.ru",
              "pathPrefix": "/events/"
            },
            {
              "scheme": "https",
              "host": "mesto-go.ru",
              "pathPrefix": "/people"
            },
            {
              "scheme": "https",
              "host": "mesto-go.ru",
              "pathPrefix": "/chats"
            },
            {
              "scheme": "https",
              "host": "mesto-go.ru",
              "pathPrefix": "/city/"
            },
            {
              "scheme": "https",
              "host": "mesto-go.ru",
              "path": "/my-events"
            },
            {
              "scheme": "https",
              "host": "mesto-go.ru",
              "path": "/notifications"
            },
            {
              "scheme": "https",
              "host": "www.mesto-go.ru"
            },
            {
              "scheme": "https",
              "host": "mesto-go.ru",
              "pathPrefix": "/app-login"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-iap",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Чтобы показать встречи рядом с тобой на карте."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Чтобы выбрать фото для профиля и встречи."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6C3BFF"
        }
      ],
      "./plugins/with-rustore-push"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://mesto-go.ru",
      "eas": {
        "projectId": ""
      },
      "appleLogin": true
    }
  }
}