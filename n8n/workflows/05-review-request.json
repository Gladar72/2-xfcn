{
  "name": "05 — После встречи: запросить отзыв",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 30 }] }
      },
      "id": "schedule-trigger",
      "name": "Schedule: каждые 30 минут",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.APP_URL }}/api/n8n/due-review-requests",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-n8n-api-key", "value": "={{ $env.N8N_API_KEY }}" }]
        },
        "options": {}
      },
      "id": "http-due-review-requests",
      "name": "GET /api/n8n/due-review-requests",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    },
    {
      "parameters": { "fieldToSplitOut": "items", "options": {} },
      "id": "split-events",
      "name": "Split events",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [780, 300]
    },
    {
      "parameters": { "fieldToSplitOut": "recipients", "options": {} },
      "id": "split-recipients",
      "name": "Split recipients",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [1040, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.recipients }}",
        "text": "=Как прошла встреча «{{ $json.title }}»? Поставьте оценку в приложении — это помогает сообществу.",
        "additionalFields": {}
      },
      "id": "telegram-send",
      "name": "Telegram: Send Message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1300, 300],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Meetup Bot"
        }
      }
    }
  ],
  "connections": {
    "Schedule: каждые 30 минут": {
      "main": [[{ "node": "GET /api/n8n/due-review-requests", "type": "main", "index": 0 }]]
    },
    "GET /api/n8n/due-review-requests": {
      "main": [[{ "node": "Split events", "type": "main", "index": 0 }]]
    },
    "Split events": {
      "main": [[{ "node": "Split recipients", "type": "main", "index": 0 }]]
    },
    "Split recipients": {
      "main": [[{ "node": "Telegram: Send Message", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
