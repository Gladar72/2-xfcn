# === Supabase ===
# Найдёшь в Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Секретный ключ. НИКОГДА не должен попадать в клиентский код или в git.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → API → JWT Settings → JWT Secret.
# Нужен, чтобы backend мог выпускать собственный токен после проверки Telegram initData
# (мы не используем стандартную Supabase Auth, а свою — через Telegram).
SUPABASE_JWT_SECRET=

# === Telegram ===
# Получаешь у @BotFather после создания бота
TELEGRAM_BOT_TOKEN=
# Случайная строка для проверки, что вебхук действительно вызывает Telegram (не обязателен, но рекомендован)
TELEGRAM_WEBHOOK_SECRET=

# === Yandex Maps ===
# https://developer.tech.yandex.ru/
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# === Приложение ===
# Публичный URL продакшн-деплоя (Vercel), без слэша на конце
APP_URL=

# === Admin ===
# Telegram user_id (числа), через запятую, кто имеет доступ к /admin
ADMIN_TELEGRAM_IDS=

# === n8n (заполняется на этапе автоматизаций) ===
N8N_WEBHOOK_URL=
N8N_API_KEY=
