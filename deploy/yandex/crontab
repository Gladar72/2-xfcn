# Фоновые задачи «Места» (раньше — vercel.json → crons). Время — UTC, как на Vercel.
CRON_TZ=UTC
*/5 * * * *  bash /opt/mesto/app/deploy/yandex/cron.sh /api/cron/complete-events
10 0 * * *   bash /opt/mesto/app/deploy/yandex/cron.sh /api/cron/schedule-morning-reminders
*/5 * * * *  bash /opt/mesto/app/deploy/yandex/cron.sh /api/cron/send-morning-reminders
*/5 * * * *  bash /opt/mesto/app/deploy/yandex/cron.sh /api/cron/event-reminders
17 * * * *   bash /opt/mesto/app/deploy/yandex/cron.sh /api/cron/subscriptions
# Сторож дублей уведомлений: молчит, если всё чисто; иначе пишет админам в бота.
25 * * * *   bash /opt/mesto/app/deploy/yandex/cron.sh /api/cron/notification-dupes
52 4 * * *   bash /opt/mesto/app/deploy/yandex/cron.sh /api/cron/outreach
33 21 * * *  bash /opt/mesto/app/deploy/yandex/cron.sh /api/cron/places
# Состояние сервера админам в бота: сводка каждый день в 08:55 по Тюмени (03:55 UTC),
# а раз в час — тревога, только если сайт/база/бот сломались.
55 3 * * *   bash /opt/mesto/app/deploy/yandex/health.sh
7 * * * *    bash /opt/mesto/app/deploy/yandex/health.sh --alert
# Резервная копия базы каждую ночь (хранится 14 дней в /opt/backups).
40 23 * * *  bash /opt/mesto/app/deploy/yandex/backup.sh
