CRON_TZ=UTC
*/5 * * * *  bash /opt/mesto/app/deploy/yandex/cron.sh /api/cron/complete-events
10 0 * * *   bash /opt/mesto/app/deploy/yandex/cron.sh /api/cron/schedule-morning-reminders
*/5 * * * *  bash /opt/mesto/app/deploy/yandex/cron.sh /api/cron/send-morning-reminders
*/5 * * * *  bash /opt/mesto/app/deploy/yandex/cron.sh /api/cron/event-reminders
