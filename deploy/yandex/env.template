# Настройки сервера «Места» в Yandex Cloud. ЗНАЧЕНИЯ СЮДА НЕ ВПИСЫВАТЬ И НЕ КОММИТИТЬ!
# Скопируй этот список в заметки, заполни и вставь целиком в GitHub:
#   Settings → Secrets and variables → Actions → New repository secret → YC_APP_ENV
# Строки вида KEY=value, без кавычек.

# --- Адреса (так и оставить) ---
APP_URL=https://mesto-go.ru
NEXT_PUBLIC_SUPABASE_URL=https://db.mesto-go.ru
API_HOST=db.mesto-go.ru
APP_HOSTS=new.mesto-go.ru
ACME_EMAIL=                      # твоя почта для HTTPS-сертификатов
CRON_ENABLED=0                   # при переезде поменяем на 1
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=Mesto_people_bot

# --- Supabase: supabase.com → проект → Project Settings → API Keys (вкладка Legacy) и JWT Keys (Legacy JWT secret) ---
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # anon public
SUPABASE_SERVICE_ROLE_KEY=       # service_role secret
SUPABASE_JWT_SECRET=             # Legacy JWT secret

# --- Telegram: @BotFather → /mybots → бот → API Token ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=         # любая случайная строка из букв и цифр (32 символа) — вебхук перенастроим при переезде
ADMIN_TELEGRAM_IDS=              # твой Telegram ID (через запятую, если несколько)

# --- ЮKassa: yookassa.ru → Интеграция → Ключи API ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Яндекс Карты / Геокодер: developer.tech.yandex.ru → Кабинет разработчика ---
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
YANDEX_GEOCODER_API_KEY=
YANDEX_PLACES_API_KEY=           # если есть (Поиск по организациям)

# --- Yandex Cloud: YandexGPT (сервисный аккаунт → API-ключ) и Postbox (статический ключ доступа) ---
YANDEX_FOLDER_ID=
YANDEX_GPT_API_KEY=
YANDEX_GPT_MODEL=yandexgpt-lite
POSTBOX_ACCESS_KEY_ID=
POSTBOX_SECRET_KEY=
MAIL_FROM=                       # например noreply@mesto-go.ru
MAIL_FROM_NAME=МЕСТО

# --- Проверка фото: sightengine.com → Dashboard → API keys ---
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# --- Прочее ---
CRON_SECRET=                     # любая случайная строка (32 символа)
N8N_WEBHOOK_URL=                 # если пользуешься n8n
N8N_API_KEY=
SMSRU_API_ID=                    # если включишь вход по SMS
EXPO_ACCESS_TOKEN=               # необязательно (push в приложение)
# Apple (когда будет аккаунт разработчика): APPLE_TEAM_ID, APPLE_IAP_KEY_ID, APPLE_IAP_ISSUER_ID, APPLE_IAP_PRIVATE_KEY
